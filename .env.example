# ==============================================================================
# SwitchGuard Enterprise SRE Configuration
# ==============================================================================

# Environment
SWITCHGUARD_ENV=production
DEBUG=false

# Switch Core Integration
SWITCH_CORE_URL=http://127.0.0.1:49742
SWITCH_AUTH_TOKEN=your-switch-auth-token-here

# Collaboration Bridge Tokens
DISCORD_BOT_TOKEN=your-discord-bot-token
DISCORD_INCIDENT_CHANNEL_ID=1566898573671665826
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token
SLACK_INCIDENT_CHANNEL_ID=C0123456789

# Telemetry Webhook Ingestion Secrets
SENTRY_WEBHOOK_SECRET=your-sentry-secret
DATADOG_API_KEY=your-datadog-api-key

# SRE SLA Policies (Minutes)
P0_MTTA_MINUTES=5
P0_MTTR_MINUTES=30
P1_MTTA_MINUTES=15
P1_MTTR_MINUTES=120

# Governance & Approvers (Comma-separated handles)
AUTHORIZED_APPROVERS=Shubham,sre-lead,infrastructure-oncall
APPROVAL_TIMEOUT_SECONDS=900
